{
  "manifest_version": 3,
  "name": "aiyu — AI 譯語",
  "version": "0.3.3",
  "key": "",
  "description": "用 claude 或 codex 翻譯 YouTube 字幕，預設台灣正體中文。",
  "permissions": ["nativeMessaging", "storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/yt-key-shim.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/search-box.js", "content/translate-scheduler.js", "content/youtube.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/logo.png"],
      "matches": ["*://*.youtube.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
